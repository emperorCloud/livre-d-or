# Aucune valeur réelle ici : ce fichier est versionné. Les vraies valeurs vivent
# uniquement dans Vercel (Settings > Environment Variables) et dans .env.local (ignoré par git).

# Injectée par Vercel quand la base Postgres/Neon est connectée au projet.
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# Injectée par Vercel quand le Blob store est connecté au projet.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Mot de passe de l'espace administrateur : longue phrase de passe, jamais un mot simple.
ADMIN_PASSCODE="changez-moi"

# Secret de signature des sessions : openssl rand -base64 32
SESSION_SECRET="changez-moi-chaine-aleatoire-longue"

# --- Stockage des photos ---------------------------------------------------------------
# "blob" (défaut) = Vercel Blob. "r2" = Cloudflare R2 (migration : scripts/migrate-storage.mts).
STORAGE_DRIVER="blob"
# Uniquement si STORAGE_DRIVER="r2" :
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://photos.votre-domaine.com"
