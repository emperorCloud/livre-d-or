# === Base de données (Vercel Postgres) ===
# Injectée AUTOMATIQUEMENT par Vercel quand vous connectez une base
# "Vercel Postgres" (ou Neon) à ce projet depuis l'onglet "Storage" du
# dashboard Vercel. Vous n'avez normalement rien à faire ici en production.
# En local, copiez la valeur depuis Vercel (Settings > Environment Variables).
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# === Stockage des photos (Vercel Blob) ===
# Injectée AUTOMATIQUEMENT quand vous créez un "Blob Store" depuis l'onglet
# "Storage" du dashboard Vercel et le connectez à ce projet.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# === Authentification admin ===
# Le mot de passe pour accéder à l'espace admin du livre d'or.
# Changez-le librement, y compris après le déploiement (Settings > Environment
# Variables sur Vercel, puis redéployez).
ADMIN_PASSCODE="edimo2026"

# Secret utilisé pour SIGNER la session admin (cookie). Doit être une longue
# chaîne aléatoire, gardée secrète. Générez-en une avec :
#   openssl rand -base64 32
# NE PARTAGEZ JAMAIS cette valeur, ne la committez jamais dans Git.
SESSION_SECRET="remplacez-moi-par-une-chaine-aleatoire-longue"
